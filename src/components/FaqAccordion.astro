---
import type { FaqItem } from "../data/faq";

interface Props {
  items: FaqItem[];
  name?: string;
}

const { items, name = "faq" } = Astro.props;
---
<div class="border-y border-foreground/10" data-faq-accordion>
  {items.map((item) => (
    <details name={name} class="group border-b border-foreground/10 last:border-b-0">
      <summary class="faq-summary cursor-pointer list-none py-6 font-display text-xl md:text-2xl font-normal text-foreground marker:content-none [&::-webkit-details-marker]:hidden">
        <span class="flex items-start justify-between gap-6">
          <span>{item.question}</span>
          <span class="mt-1 shrink-0 font-body text-base text-foreground/50 group-open:hidden" aria-hidden="true">
            +
          </span>
          <span class="mt-1 hidden shrink-0 font-body text-base text-foreground/50 group-open:inline" aria-hidden="true">
            −
          </span>
        </span>
      </summary>
      <p class="pb-6 font-body text-base md:text-lg leading-relaxed text-foreground">
        {item.answer}
      </p>
    </details>
  ))}
</div>

<style>
  .faq-summary {
    list-style: none;
  }
  .faq-summary:focus {
    outline: none;
  }
  .faq-summary:focus-visible {
    outline: 2px solid hsl(var(--foreground));
    outline-offset: 4px;
  }
</style>
