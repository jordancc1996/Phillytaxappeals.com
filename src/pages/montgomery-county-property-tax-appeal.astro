---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation";
import AppealRequestForm from "../components/AppealRequestForm";
import Footer from "../components/Footer";
import FAQSection from "../components/FAQSection.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import GooglePreferredSource from "../components/GooglePreferredSource.astro";
import { Toaster } from "../components/ui/toaster";
import { createCountyPageSchema } from "../lib/schemas";
import { getCountyFaqItems } from "../data/faq";
import montgomeryCountyImage from "../assets/montgomery-county.jpg";

const title = "Montgomery County Property Tax Appeals | Expert Tax Reduction Services";
const description = "Montgomery County property tax appeal services that reduce your tax burden with local expertise and no upfront costs. Free assessment evaluation available.";
const canonicalUrl = "https://phillytaxappeals.com/montgomery-county-property-tax-appeal";
const ogImage = "https://phillytaxappeals.com/og-image.jpg";
const pageFaq = getCountyFaqItems("montgomery");
const schema = createCountyPageSchema("Montgomery County", canonicalUrl, pageFaq);
const imageSrc = typeof montgomeryCountyImage === "string" ? montgomeryCountyImage : montgomeryCountyImage.src;
---
<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Philly Tax Appeals" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <div class="min-h-screen bg-background">
    <Navigation client:load variant="dark" />

    <div class="max-w-7xl mx-auto px-8 pt-24 md:pt-28">
      <Breadcrumb items={[{ href: "/", label: "Home" }, { label: "Montgomery County" }]} />
    </div>

    <div class="max-w-7xl mx-auto px-8 py-12 md:py-16">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-light mb-12 text-foreground lowercase">
        Montgomery County Property Tax Appeals
      </h1>

      <div class="mb-16" data-reveal>
        <img
          src={imageSrc}
          alt="Montgomery County Pennsylvania property for tax appeal services"
          class="w-full h-[400px] object-cover"
          width="1600"
          height="400"
        />
      </div>

      <div class="grid md:grid-cols-2 gap-x-24 gap-y-16">
        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Specialized Montgomery County Tax Appeal Service
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Navigate Montgomery County property tax appeals with confidence, backed by our experienced team's comprehensive analysis and expert representation tailored to local procedures. As a{" "}
            <a href="/" class="underline underline-offset-4 hover:opacity-70 transition-opacity">
              Philadelphia-based tax appeal firm
            </a>
            , we bring regional expertise to every case.
          </p>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Montgomery County-Specific Knowledge
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Our deep understanding of Montgomery County assessment methodologies and appeal processes ensures your case is presented effectively to achieve maximum tax reduction.
          </p>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Risk-Free Property Tax Approach
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Begin with a complimentary assessment review. Our contingency-based fee structure means you pay nothing unless we successfully reduce your property taxes.
          </p>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Successful Tax Appeal Outcomes
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Montgomery County property owners trust us to deliver results. Our systematic approach and local expertise consistently achieve meaningful tax savings.
          </p>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-8">
      <GooglePreferredSource />
    </div>

    <FAQSection items={pageFaq} name="montgomery-faq" showDeadlineNote={true} />
    <AppealRequestForm client:load />
    <Footer />
    <Toaster client:load />
  </div>
</Layout>
