---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation";
import Footer from "../components/Footer";
import Breadcrumb from "../components/Breadcrumb.astro";
import { breadcrumbListNode } from "../lib/schemas";

const title = "Philadelphia Property Tax Resources - Free Appeal Tools";
const metaTitle = `${title} | Philly Tax Appeals`;
const description =
  "Philadelphia property tax resources for 2026 OPA assessments, plus a free evaluation. Review your options on this page and start with no upfront cost.";
const canonicalUrl = "https://phillytaxappeals.com/tools";
const ogImage = "https://phillytaxappeals.com/og-image.jpg";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#page`,
      "url": canonicalUrl,
      "name": title,
      "description": description,
      "isPartOf": { "@id": "https://phillytaxappeals.com/#website" },
      "breadcrumb": breadcrumbListNode(canonicalUrl, [
        { name: "Home", item: "https://phillytaxappeals.com" },
        { name: "Tools", item: canonicalUrl },
      ]),
    },
  ],
};
const linkClass = "underline underline-offset-4 hover:opacity-70 transition-opacity";
---
<Layout>
  <Fragment slot="head">
    <title>{metaTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Philly Tax Appeals" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <div class="min-h-screen bg-background">
    <Navigation client:load variant="dark" />

    <div class="max-w-7xl mx-auto px-8 pt-24 md:pt-28">
      <Breadcrumb items={[{ href: "/", label: "Home" }, { label: "Tools" }]} />
    </div>

    <div class="max-w-7xl mx-auto px-8 py-12 md:py-16">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-light mb-12 text-foreground lowercase">
        tools
      </h1>

      <div class="grid md:grid-cols-2 gap-x-24 gap-y-16">
        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Property Tax Resources
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Access our collection of free tools and resources designed to help you understand your property tax assessment and potential savings. We serve{" "}
            <a href="/philadelphia-property-tax-appeal" class={linkClass}>
              Philadelphia
            </a>
            , Bucks County, Delaware County, and Montgomery County.
          </p>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Real Estate Estimator
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Use our Real Estate Estimator to compare your assessed value against market value and calculate your potential property tax savings.
          </p>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Free Evaluation
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            In the meantime, the best tool at your disposal is our free property assessment evaluation.{" "}
            <a href="/contact" class={linkClass}>
              Contact us today
            </a>
            {" "}to get started with no upfront costs.
          </p>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Expert Guidance
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Our team of property tax experts can guide you through the appeal process and help you understand your options. We work on contingency, so you only pay if we win.
          </p>
        </div>
      </div>
    </div>

    <Footer />
  </div>
</Layout>
