---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation";
import AppealRequestForm from "../components/AppealRequestForm";
import Footer from "../components/Footer";
import FAQSection from "../components/FAQSection.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import GooglePreferredSource from "../components/GooglePreferredSource.astro";
import { Toaster } from "../components/ui/toaster";
import { createCountyPageSchema } from "../lib/schemas";
import { getCountyFaqItems } from "../data/faq";
import philadelphiaImage from "../assets/philadelphia.jpg";

const title = "Philadelphia Property Tax Appeals | Expert Tax Reduction Services";
const description = "Professional Philadelphia property tax appeal services. Reduce your property tax burden with our local expertise and no upfront costs. Free assessment evaluation.";
const canonicalUrl = "https://phillytaxappeals.com/philadelphia-property-tax-appeal";
const ogImage = "https://phillytaxappeals.com/og-image.jpg";
const pageFaq = getCountyFaqItems("philadelphia");
const schema = createCountyPageSchema("Philadelphia", canonicalUrl, pageFaq);
const imageSrc = typeof philadelphiaImage === "string" ? philadelphiaImage : philadelphiaImage.src;
---
<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Philly Tax Appeals" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <div class="min-h-screen bg-background">
    <Navigation client:load variant="dark" />

    <div class="max-w-7xl mx-auto px-8 pt-24 md:pt-28">
      <Breadcrumb items={[{ href: "/", label: "Home" }, { label: "Philadelphia" }]} />
    </div>

    <div class="max-w-7xl mx-auto px-8 py-12 md:py-16">
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-display font-light mb-12 text-foreground lowercase">
        Philadelphia Property Tax Appeals
      </h1>

      <div class="mb-16" data-reveal>
        <img
          src={imageSrc}
          alt="Historic Philadelphia row homes with stone facades"
          class="w-full h-[400px] object-cover rounded-sm"
          width="1600"
          height="400"
        />
      </div>

      <div class="grid md:grid-cols-2 gap-x-24 gap-y-16">
        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Philadelphia Property Tax Expertise
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            In Philadelphia, our property tax appeal experts bring unparalleled expertise navigating the city's assessment system. Our team knows the local process inside and out. Learn more about our{" "}
            <a href="/" class="underline underline-offset-4 hover:opacity-70 transition-opacity">
              Philadelphia tax appeal services
            </a>
            .
          </p>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Philadelphia City Assessment System
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Philadelphia's assessment system has unique characteristics that require specialized knowledge. We leverage our experience to build compelling cases for tax reduction.
          </p>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            No Upfront Costs for Tax Appeals
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Start with a free evaluation of your property assessment. We work on contingency, ensuring our interests are aligned with achieving savings for you.
          </p>
        </div>

        <div>
          <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
            Proven Philadelphia Tax Appeal Results
          </h2>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Our Philadelphia roots and track record speak for themselves. We've helped countless city property owners reduce their tax burden through effective appeals.
          </p>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-8">
      <GooglePreferredSource />
    </div>

    <FAQSection items={pageFaq} name="philadelphia-faq" showDeadlineNote={true} />
    <AppealRequestForm client:load />
    <Footer />
    <Toaster client:load />
  </div>
</Layout>
