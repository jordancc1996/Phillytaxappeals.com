---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation";
import Footer from "../components/Footer";
import FAQSection from "../components/FAQSection.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import GooglePreferredSource from "../components/GooglePreferredSource.astro";
import { createFaqPageSchema } from "../lib/schemas";
import {
  faqHubSections,
  faqTopics,
  getFaqHubAccordionItems,
  getFaqItemsByIds,
} from "../data/faq";

const title = "Property Tax Appeal FAQ - Pennsylvania County Deadlines";
const metaTitle = `${title} | Philly Tax Appeals`;
const description =
  "Property tax appeal FAQ for Pennsylvania counties, including Philadelphia's October 5, 2026 BRT deadline. Confirm dates on each county's official site.";
const canonicalUrl = "https://phillytaxappeals.com/faq";
const ogImage = "https://phillytaxappeals.com/og-image.jpg";
const hubAccordionItems = getFaqHubAccordionItems();
const schema = createFaqPageSchema(canonicalUrl, title, description, hubAccordionItems);
const countySections = faqHubSections.filter((section) => section.topicId !== "general");
---
<Layout>
  <Fragment slot="head">
    <title>{metaTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Philly Tax Appeals" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <div class="min-h-screen bg-background">
    <Navigation client:load variant="dark" />

    <div class="px-12 md:px-20 pt-24 md:pt-28">
      <div class="max-w-[1600px] mx-auto">
        <div class="max-w-[800px] mx-auto">
          <Breadcrumb items={[{ href: "/", label: "Home" }, { label: "FAQ" }]} />
          <h1 class="mt-10 text-5xl md:text-6xl lg:text-7xl font-display font-light mb-12 text-foreground lowercase">
            Property Tax Appeal FAQ
          </h1>
          <p class="text-foreground font-body text-base md:text-lg leading-relaxed">
            Property tax appeal FAQ answers for Philadelphia start with the city's filing calendar, not a suburban county board. Use the questions below, then open the{" "}
            <a href="/philadelphia-property-tax-appeal" class="underline underline-offset-4 hover:opacity-70 transition-opacity">
              Philadelphia property tax appeal
            </a>
            {" "}page for your neighborhood.
          </p>
          <GooglePreferredSource />
        </div>
      </div>
    </div>

    <FAQSection
      items={hubAccordionItems}
      name="faq-general"
      heading="Pennsylvania property tax appeals"
      showDeadlineNote={true}
      showIndexLink={false}
    >
      <div class="mt-16 space-y-16">
        {countySections.map((section) => {
          const topic = faqTopics[section.topicId];
          const items = getFaqItemsByIds(section.topicId, section.itemIds);
          return (
            <div>
              <h2 class="text-2xl md:text-3xl font-display font-normal text-foreground mb-6">
                {topic.heading}
              </h2>
              {topic.href && topic.hrefLabel && (
                <p class="font-body text-base md:text-lg leading-relaxed text-foreground mb-6">
                  Next:{" "}
                  <a href={topic.href} class="underline underline-offset-4 hover:opacity-70 transition-opacity">
                    {topic.hrefLabel}
                  </a>
                  .
                </p>
              )}
              <div class="space-y-7">
                {items.map((item) => (
                  <p class="font-body text-base md:text-lg leading-relaxed text-foreground">
                    {item.answer}
                  </p>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </FAQSection>

    <Footer />
  </div>
</Layout>
